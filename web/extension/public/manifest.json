{
  "manifest_version": 3,
  "name": "Prophylaxis",
  "version": "0.1.0",
  "description": "After a chess.com game ends: your biggest moment, the habit behind it, and a chance to retry it. Never runs during play.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "sidePanel", "offscreen"],
  "host_permissions": ["https://api.chess.com/*", "http://localhost:5173/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    { "matches": ["https://www.chess.com/*"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "side_panel": { "default_path": "panel.html" },
  "action": {
    "default_title": "Prophylaxis",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
